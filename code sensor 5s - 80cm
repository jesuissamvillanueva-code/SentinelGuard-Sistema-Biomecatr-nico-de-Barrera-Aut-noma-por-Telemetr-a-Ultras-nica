#include <Servo.h>  

Servo servo;     
const int trigPin = 5;    
const int echoPin = 6;   
const int servoPin = 7;

long duration, dist;    
long aver[3];  

void setup() { 
    // Configuración de pines del sensor ultrasónico
    pinMode(trigPin, OUTPUT);  
    pinMode(echoPin, INPUT);  
    
    // Evita movimientos bruscos al encender: 
    // Posiciona el servo a 0° antes de acoplarlo
    servo.write(0);          
    delay(100);
    servo.attach(servoPin);  
    delay(100);
    servo.detach();          // Lo desacoplamos en reposo para que no vibre
}

void measure() {  
    digitalWrite(trigPin, LOW);
    delayMicroseconds(2);
    digitalWrite(trigPin, HIGH);
    delayMicroseconds(10);
    digitalWrite(trigPin, LOW);

    duration = pulseIn(echoPin, HIGH);
    dist = (duration / 2) / 29.1;    
}

void loop() { 
    // Toma un promedio de 3 lecturas para evitar falsos positivos
    for (int i = 0; i <= 2; i++) {  
        measure();             
        aver[i] = dist;            
        delay(10);            
    }
    dist = (aver[0] + aver[1] + aver[2]) / 3;    

    // RANGO ACTUALIZADO: Detecta objetos entre 30 cm y 80 cm
    if (dist >= 30 && dist <= 80) {
        servo.attach(servoPin); // Activa el servo únicamente al cumplirse la distancia
        delay(5);
        
        // GIRO RÁPIDO: Avanza gradualmente de 0° a 180° a máxima velocidad
        for (int pos = 0; pos <= 180; pos += 5) {
            servo.write(pos);
            delay(5); // Ajusta este valor entre 2 y 8 si deseas regular la velocidad máxima
        }
        
        // TIEMPO DE ESPERA: Se queda arriba exactamente 5 segundos
        delay(5000);            
        
        // RETORNO RÁPIDO: Vuelve de 180° a 0° rápidamente
        for (int pos = 180; pos >= 0; pos -= 5) {
            servo.write(pos);
            delay(5);
        }
        
        delay(200);
        servo.detach();         // Desacopla el servo para que quede libre y sin corriente
    }
}
